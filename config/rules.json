      "id": "zombie",
      "trigger": {
        "type": "reward",
        "name": "Invocar zombie"
      },
      "cooldownMs": 10000,
      "actions": [
        {
          "type": "minecraft",
          "commands": [
            "execute at {player} run summon minecraft:zombie ~3 ~ ~3"
          ]
        },
        {
          "type": "announce",
          "text": "{user} te mandó un zombie",
          "color": "green"
        },
        {
          "type": "chat",
          "message": "🧟 {user} invocó un zombie a {player}"
        }
      ]
    },
