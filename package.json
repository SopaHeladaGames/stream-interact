{
  "name": "stream-interact",
  "version": "0.4.0",
  "description": "Permite que el chat de tus directos (Twitch, luego Kick/YouTube) interactúe con tu juego.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "simular": "node scripts/simular.js",
    "panel:install": "npm --prefix panel install",
    "panel:dev": "npm --prefix panel run dev",
    "panel:build": "npm --prefix panel run build",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "dist": "npm run panel:build && electron-builder --win nsis",
    "publicar": "node scripts/publicar.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "rcon-client": "^4.2.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.0.12"
  },
  "author": "SopaHeladaGames",
  "build": {
    "appId": "com.sopahelada.streaminteract",
    "productName": "Sopa-ChatBot",
    "copyright": "SopaHeladaGames",
    "directories": {
      "output": "dist-instalador"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "overlay/**/*",
      "panel/dist/**/*",
      "config/rules.json",
      ".env.example",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sopa-ChatBot",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Sopa-ChatBot-instalador-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SopaHeladaGames",
        "repo": "stream-interact",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "electron/assets/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SopaHeladaGames/stream-interact.git"
  }
}
