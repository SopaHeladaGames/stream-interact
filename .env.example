# Copia este archivo como .env y llena los valores. El .env NO se sube a Git.

# --- Twitch (dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la "OAuth Redirect URL" registrada en tu app de Twitch
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Servidor local (login + panel de control) ---
PORT=3000

# --- Minecraft (RCON) ---
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
# Tu nombre de jugador en Minecraft (se usa como {player} en las reglas)
MC_PLAYER=

# --- Servidor de Minecraft controlado por la app (opcional) ---
# Carpeta donde está paper.jar. Con esto puedes iniciarlo/detenerlo desde el panel.
MC_SERVER_DIR=C:\Users\vitro\dev\mc-server
# Ruta a java.exe si "java" del PATH no es la versión correcta
# MC_JAVA=C:\Program Files\Amazon Corretto\jdk25.0.5_10\bin\java.exe
MC_MEMORY_MIN=2G
MC_MEMORY_MAX=4G
# Reiniciar solo si se cae (true/false)
MC_AUTO_RESTART=true
# Iniciar el servidor automáticamente al abrir la app (true/false)
MC_SERVER_AUTOSTART=false

# --- Donaciones ---
# Los tokens de Streamlabs, StreamElements y Ko-fi se configuran en el panel (página Donaciones).
# Puerto aparte para los webhooks de Ko-fi (el único que se expone con el túnel)
WEBHOOK_PORT=3001

# --- App de escritorio ---
# Atajo global para pausar/reanudar (funciona aunque estés dentro del juego)
PANIC_SHORTCUT=CommandOrControl+Shift+P

# Responder en el chat de Twitch cuando se ejecute una acción (true/false)
CHAT_REPLIES=true
